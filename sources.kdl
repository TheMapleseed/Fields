format "text" {
  status "current"
  encoding "GeoJSON or WKT plus prose"
  fields "instruction, input, output"
  note "Ask a farm question about a contour, soil, or parcel written as coordinates and properties. The answer states the risk or reading in sentences."
}

format "vision" {
  status "georeferenced-chips"
  encoding "sheet chip plus the pixel that contains the coordinate"
  note "Cut the chip from a GeoTIFF whose coordinate system is still attached. The labeled pixel comes from that transform, so the point sits on the correct contour. A screenshot has no coordinate system and cannot be plotted. Foliage sheets are NAIP. Topographic sheets are USGS maps."
}
