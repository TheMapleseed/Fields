// Source catalog for Fields. Collection code does not read this file yet.
// The model is text-only. Map sources are listed so their features can be
// written as GeoJSON or Well-Known Text plus a prose description.
// Licenses below are what the publisher pages state. Keep the license with every record.

source "openstax" {
  title "OpenStax"
  publisher "Rice University"
  home "https://openstax.org"
  kind "textbooks"
  note "Read the license on each book page. The books are not all CC BY."
  item {
    title "Writing Guide with Handbook"
    domain "english"
    url "https://openstax.org/details/books/writing-guide"
    covers "grammar, structure, and synthesis"
    license "see-book-page"
  }
  item {
    title "Algebra and Trigonometry 2e"
    domain "mathematics"
    url "https://openstax.org/details/books/algebra-and-trigonometry-2e"
    covers "algebra and trigonometry"
    license "see-book-page"
  }
  item {
    title "Precalculus 2e"
    domain "mathematics"
    url "https://openstax.org/details/books/precalculus-2e"
    covers "functions, trigonometry, and an introduction to calculus"
    license "see-book-page"
  }
  item {
    title "Calculus Volume 1"
    domain "mathematics"
    url "https://openstax.org/details/books/calculus-volume-1"
    covers "functions, limits, derivatives, and integration"
    license "CC-BY-NC-SA-4.0"
  }
  item {
    title "Calculus Volume 2"
    domain "mathematics"
    url "https://openstax.org/details/books/calculus-volume-2"
    covers "integration techniques, sequences, and series"
    license "see-book-page"
  }
  item {
    title "Calculus Volume 3"
    domain "mathematics"
    url "https://openstax.org/details/books/calculus-volume-3"
    covers "multivariable and vector calculus"
    license "see-book-page"
  }
  item {
    title "Biology 2e"
    domain "biology"
    url "https://openstax.org/details/books/biology-2e"
    covers "cell biology, plant physiology, and genetics"
    license "see-book-page"
  }
  item {
    title "Chemistry 2e"
    domain "chemistry"
    url "https://openstax.org/details/books/chemistry-2e"
    covers "general chemistry, including soil-chemistry fundamentals"
    license "see-book-page"
  }
  item {
    title "Organic Chemistry: A Tenth Edition"
    domain "chemistry"
    url "https://openstax.org/details/books/organic-chemistry"
    covers "organic chemistry and biochemistry foundations"
    license "see-book-page"
  }
  item {
    title "College Physics 2e"
    domain "physics"
    url "https://openstax.org/details/books/college-physics-2e"
    covers "fluids, heat, and light, which are the physics used in irrigation and weather"
    license "see-book-page"
  }
}

source "mit-ocw" {
  title "MIT OpenCourseWare"
  publisher "Massachusetts Institute of Technology"
  home "https://ocw.mit.edu"
  kind "lecture-notes"
  note "18.901 is the topology course. 18.101 is Analysis and Manifolds, not a topology course. Confirm the license on the course page."
  item {
    title "18.901 Introduction to Topology"
    domain "topology"
    url "https://ocw.mit.edu/courses/18-901-introduction-to-topology-fall-2004/"
    covers "topological spaces, continuous functions, connectedness, and compactness"
    license "see-course-page"
  }
}

