// FarmSLM architecture.
// The context window is 500000 tokens. The model reads that window in segments
// and carries memory_slots forward at each layer. Weights are safetensors.
model {
  vocab_size 512
  hidden_size 512
  intermediate_size 1536
  num_hidden_layers 8
  num_attention_heads 8
  num_key_value_heads 2
  max_position_embeddings 500000
  segment_length 2048
  memory_slots 256
  // Frequency base shared with RoPE-style schedules. Positions use FoPE.
  rope_theta 1000000.0
  fope_floor_length 8192
  fope_init_gain 0.1
  rms_norm_eps 1e-6
  image_channels 3
  patch_size 16
  image_size 256
}

domains {
  domain "english"
  domain "agricultural_linguistics"
  domain "chemistry"
  domain "weather_reading"
  domain "physics"
}

collection {
  max_repos_per_query 10
  max_files_per_repo 40
  max_file_bytes 1000000
  max_total_bytes 20000000
  max_queries_per_domain 32
  // Permanent corpus pulls stay off. Machines train by pulling one item per step.
  fetch_catalog 0
  fetch_during_train 1
  // Discard pulled text after each step so disks do not keep the corpus.
  ephemeral_corpus 1
  ephemeral_items_per_step 1
  // One OpenStax WEB PDF may be ~200-300MB while its pages are walked, then deleted.
  pdf_max_bytes 350000000
  pdf_chars_per_page 12000
}

train {
  learning_rate 0.0003
  steps 5
  weight_decay 0.01
  grad_clip 1.0
  seed 42
  max_train_tokens 8192
  // Model + optimizer safetensors and stage.kdl under this directory.
  // resume 1 reloads weights and the ephemeral job/page cursor automatically.
  checkpoint_dir "artifacts/checkpoints"
  checkpoint_every 1
  resume 1
  // Set to an ISO country code or place name to keep that region out of training.
  hold_out_region "none"
}

maps {
  chip_size 256
}

// RUSLE in US customary units. Soil loss is tons per acre per year.
// Slope bands are the integer slope classes in the Wischmeier and Smith support tables.
// The last number on a band is the maximum slope length in meters. 0 means no limit.
// Cover factors are planning examples, not a soil survey of any field.
erosion {
  tolerance 5
  cover "bare-fallow" 1.0
  cover "corn-grain-rotation" 0.32
  cover "orchard-grass-cover" 0.012
  cover "permanent-grass" 0.003
  support "up-and-down-slope" {
    band 0 100 1.0 0
  }
  support "contour" {
    band 1 2 0.60 120
    band 3 5 0.50 90
    band 6 8 0.50 60
    band 9 12 0.60 40
    band 13 16 0.70 25
    band 17 20 0.80 18
    band 21 25 0.90 15
  }
  support "contour-strip-crop" {
    band 1 2 0.30 250
    band 3 5 0.25 185
    band 6 8 0.25 120
    band 9 12 0.30 75
    band 13 16 0.35 50
    band 17 20 0.40 35
    band 21 25 0.45 30
  }
}

weights {
  format "safetensors"
  path "artifacts/farm_slm.safetensors"
}
