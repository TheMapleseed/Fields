// Compact English seed list for ephemeral dictionary pulls during training.
// Words are looked up through dictionaryapi.dev (English Wiktionary text, CC BY-SA).
// Keep this file small. Training machines pull definitions on the step and discard them.
// This is not the full Wiktionary; it is a farm-and-prose starter set.

seeds {
  word "the"
  word "and"
  word "of"
  word "to"
  word "in"
  word "for"
  word "with"
  word "from"
  word "field"
  word "farm"
  word "crop"
  word "soil"
